generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  adapter = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  address          String   @unique
  pubKeyX          String?
  pubKeyY          String?
  credentialId     String?
  currentChallenge String?
  name             String?
  role             Role     @default(PERSONAL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([address])
}

enum Role {
  PERSONAL
  COMPANY
}
