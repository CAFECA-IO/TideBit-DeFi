{
  "name": "tidebit-defi",
  "version": "0.9.0+97",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:env": "npx tsx scripts/initial_env.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down -v",
    "db:logs": "docker compose logs -f postgres",
    "dev": "next dev",
    "sc:clean": "npx hardhat clean",
    "sc:compile": "npx hardhat compile",
    "sc:deploy:all:isuncoin_mainnet": "npx hardhat ignition deploy ./ignition/modules/deploy.ts --network isuncoin_mainnet --reset",
    "sc:deploy:3643:isuncoin_mainnet": "npx hardhat ignition deploy ./ignition/modules/deploy_erc3643.ts --network isuncoin_mainnet --reset",
    "sc:deploy:4337:isuncoin_mainnet": "npx hardhat ignition deploy ./ignition/modules/deploy_erc4337.ts --network isuncoin_mainnet",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --fix . --cache",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|jsx|ts|tsx|json)\"",
    "check-format": "prettier --ignore-path .gitignore --list-different \"**/*.+(js|jsx|ts|tsx|json)\"",
    "validate": "prettier --ignore-path .gitignore --write \"**/*.+(js|jsx|ts|tsx|json|css)\" && eslint --fix . && npm run test",
    "update-version": "npx tsx scripts/update_version.ts && git add package.json",
    "swarm": "next start -p 10010",
    "prepare": "husky",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.6.0",
    "@erc3643org/erc-3643": "^4.1.3",
    "@onchain-id/solidity": "^2.2.1",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@passwordless-id/webauthn": "^2.3.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "apexcharts": "^5.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "next": "^16.1.1",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-usestateref": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/chai": "^4.3.20",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "autoprefixer": "^10.4.22",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.2.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "viem": "^2.43.5"
  }
}
